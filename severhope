--// =========================
--// DRAG GUI
--// =========================

local dragging = false
local dragStart
local startPos

Button.InputBegan:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPos = Button.Position

        input.Changed:Connect(function()

            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end

        end)

    end

end)

Button.InputChanged:Connect(function(input)

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then

        local connection

        connection = game:GetService("UserInputService").InputChanged:Connect(function(change)

            if not dragging then
                connection:Disconnect()
                return
            end

            if change.UserInputType == Enum.UserInputType.MouseMovement
            or change.UserInputType == Enum.UserInputType.Touch then

                local delta = change.Position - dragStart

                Button.Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )

                Status.Position = UDim2.new(
                    Button.Position.X.Scale,
                    Button.Position.X.Offset - 95,
                    Button.Position.Y.Scale,
                    Button.Position.Y.Offset + 45
                )

            end

        end)

    end

end)

--// =========================
--// GET SERVERS
--// =========================

local function GetServers()

    local servers = {}
    local cursor = ""

    for page = 1, 5 do

        local url =
            "https://games.roblox.com/v1/games/"
            .. PlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor ~= "" then
            url = url .. "&cursor=" .. HttpService:UrlEncode(cursor)
        end

        local success, result = pcall(function()

            return game:HttpGet(url)

        end)

        if not success then
            break
        end

        local data

        local decodeSuccess = pcall(function()

            data = HttpService:JSONDecode(result)

        end)

        if not decodeSuccess or not data then
            break
        end

        if data.data then

            for _, server in ipairs(data.data) do

                if server.id
                and server.playing
                and server.maxPlayers
                and server.playing >= MIN_PLAYERS
                and server.playing <= MAX_PLAYERS
                and server.id ~= CurrentJobId then

                    table.insert(servers, server)

                end

            end

        end

        cursor = data.nextPageCursor or ""

        if cursor == "" then
            break
        end

        task.wait(0.15)

    end

    return servers

end

--// =========================
--// CHOOSE SERVER
--// =========================

local function ChooseServer(servers)

    if #servers == 0 then
        return nil
    end

    -- Ưu tiên đúng 2 người
    if PREFER_TWO then

        local twoPlayerServers = {}

        for _, server in ipairs(servers) do

            if server.playing == 2 then
                table.insert(twoPlayerServers, server)
            end

        end

        if #twoPlayerServers > 0 then

            return twoPlayerServers[
                math.random(1, #twoPlayerServers)
            ]

        end

    end

    -- Không có 2 người thì chọn 1 hoặc 3
    return servers[
        math.random(1, #servers)
    ]

end

--// =========================
--// SERVER HOP
--// =========================

local hopping = false

local function ServerHop()

    if hopping then
        return
    end

    hopping = true

    Button.Text = "Searching..."
    Button.Active = false

    Status.Text = "Finding 1–3 player server..."

    local servers = GetServers()

    if #servers == 0 then

        Button.Text = "Server Hop"
        Button.Active = true

        Status.Text = "No server found"

        task.delay(2, function()

            if Status then
                Status.Text = ""
            end

        end)

        hopping = false

        return
    end

    local target = ChooseServer(servers)

    if not target then

        Button.Text = "Server Hop"
        Button.Active = true
        Status.Text = "No suitable server"

        hopping = false

        return
    end

    Status.Text =
        "Joining server: "
        .. tostring(target.playing)
        .. " players"

    Button.Text = "Teleporting..."

    task.wait(0.3)

    local success = pcall(function()

        TeleportService:TeleportToPlaceInstance(
            PlaceId,
            target.id,
            LocalPlayer
        )

    end)

    if not success then

        Button.Text = "Server Hop"
        Button.Active = true

        Status.Text = "Teleport failed"

        task.delay(2, function()

            if Status then
                Status.Text = ""
            end

        end)

        hopping = false

    end

end

--// =========================
--// BUTTON
--// =========================

Button.MouseButton1Click:Connect(function()

    ServerHop()

end)

