--========================================================
-- CONFIG
--========================================================

local MIN_PLAYERS = 1
local MAX_PLAYERS = 5

-- Tối đa quét 10 trang
-- ~1000 server
local MAX_PAGES = 10

-- Tối đa thử 20 server
local MAX_ATTEMPTS = 20

-- Thời gian chờ teleport
local TELEPORT_TIMEOUT = 8

-- Hết server thì đợi bao lâu để quét lại
local RETRY_DELAY = 2

-- Thứ tự ưu tiên
local PRIORITY = {
    2,
    3,
    1,
    4,
    5
}

